# ──────────────────────────────────────────────────────────────────────────────
# Reference for the Docker (self-hosted) .env that `npm run docker:setup` generates.
# You normally do NOT edit this by hand — run `npm run docker:setup` and it writes a
# root `.env` with secure random secrets. This file documents every key the stack reads.
# ──────────────────────────────────────────────────────────────────────────────

# --- Auto-generated secrets (crypto-random; do not reuse the placeholders below) -------------
POSTGRES_PASSWORD=replace-me-generated
JWT_SECRET=replace-me-at-least-32-chars
JWT_EXP=3600
# anon + service_role keys are HS256 JWTs SIGNED with JWT_SECRET (generated for you):
ANON_KEY=replace-me-anon-jwt
SERVICE_ROLE_KEY=replace-me-service-role-jwt
CRON_SECRET=replace-me-generated
DRAFT_MODE_SECRET=replace-me-generated
REVALIDATE_SECRET_TOKEN=replace-me-generated

# --- Supabase wiring (internal container network vs browser) ---------------------------------
# Browser reaches Kong on the host; server-side code reaches Kong inside the compose network.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
POSTGRES_DB=postgres

# --- App ------------------------------------------------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_IS_SANDBOX=true
CORTEX_AI_ENCRYPTION_KEY=

# --- MinIO object storage (S3-compatible) ----------------------------------------------------
MINIO_ROOT_USER=nextblock
MINIO_ROOT_PASSWORD=replace-me-generated
STORAGE_BUCKET=nextblock
R2_ACCOUNT_ID=minio
R2_REGION=us-east-1
R2_S3_ENDPOINT=http://minio:9000
# 127.0.0.1 (not localhost) so the browser never sends the app's localhost cookies to MinIO,
# which would otherwise 400 (MetadataTooLarge) once the Supabase auth cookies grow.
R2_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
R2_FORCE_PATH_STYLE=true
NEXT_PUBLIC_R2_BASE_URL=http://127.0.0.1:9000/nextblock
NEXT_PUBLIC_R2_PUBLIC_URL=http://127.0.0.1:9000/nextblock

# --- Cloudflare Turnstile (optional) --------------------------------------------------------
# Blank (what docker:setup writes) = no captcha: public forms are honeypot-only until you set real
# keys in CMS → Settings → Bot Protection. Never use Cloudflare's TEST keys (1x…, 2x…, 3x…): the
# test secret accepts every token, so forms would look protected while passing all bots.
# docker:setup drops them from an existing .env on re-run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP (optional). Blank => GoTrue auto-confirms sign-ups (loopback mode). -----------------
GOTRUE_MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- Optional image / host port overrides (defaults shown) -----------------------------------
# SUPABASE_DB_IMAGE=supabase/postgres:15.8.1.085
# SUPABASE_GOTRUE_IMAGE=supabase/gotrue:v2.189.0
# SUPABASE_POSTGREST_IMAGE=postgrest/postgrest:v12.2.12
# SUPABASE_KONG_IMAGE=kong:2.8.1
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# APP_PORT=3000
# KONG_HTTP_PORT=8000
# MINIO_S3_PORT=9000
# MINIO_CONSOLE_PORT=9001
# POSTGRES_PORT_EXTERNAL=54322

# --- Host interfaces the non-app ports bind to (defaults shown) -------------------------------
# Only APP_PORT is published on every interface. Postgres, MinIO (S3 API + admin console) and Kong
# bind to 127.0.0.1, so they are reachable from this machine only. A host firewall does NOT cover
# Docker-published ports (Docker's DOCKER iptables chain runs before ufw's INPUT rules), so keep
# these unless you expose a service deliberately, behind a firewall — see
# docs/11-SELF-HOSTED-DOCKER.md → "Hardening on a public server". Prefer an SSH tunnel for psql
# and the MinIO console.
# DB_BIND_HOST=127.0.0.1
# KONG_BIND_HOST=127.0.0.1
# MINIO_BIND_HOST=127.0.0.1
