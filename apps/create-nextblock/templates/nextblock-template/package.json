{
  "name": "@nextblock-cms/template",
  "version": "0.22.5",
  "description": "The open-source, full-stack AI-native CMS for Next.js 16, Supabase, and Tailwind CSS.",
  "keywords": [
    "cms",
    "nextjs",
    "nextjs16",
    "supabase",
    "rsc",
    "tailwind",
    "tiptap",
    "fullstack",
    "open-source"
  ],
  "license": "AGPL-3.0-or-later",
  "private": true,
  "nextblock": {
    "install": "standalone"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/build-migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "update": "node tools/update.mjs",
    "update:check": "node tools/update.mjs --check",
    "deploy:supabase": "node tools/deploy-supabase.js",
    "configure:supabase-auth": "node tools/configure-supabase-auth.js",
    "docker:setup": "node scripts/docker-setup.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f nextblock-cms"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/analytics": "^2.0.1",
    "katex": "^0.18.10",
    "tailwindcss-animate": "^1.0.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/react": "^3.32.0",
    "beasties": "^0.5.5",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "fast-json-patch": "^3.1.1",
    "html-react-parser": "^6.1.9",
    "js-cookie": "^3.0.8",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "plaiceholder": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.7",
    "@hookform/resolvers": "^5.9.2",
    "react-hook-form": "^7.91.0",
    "@next/third-parties": "^16.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vercel/toolbar": "^0.2.7",
    "ai": "^7.0.153",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@freemius/checkout": "^1.5.1",
    "@tiptap/core": "^3.32.0",
    "papaparse": "^5.7.0",
    "fflate": "^0.8.3",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1",
    "@nextblock-cms/ecommerce": "npm:@nextblock-cms/ecom@latest",
    "@nextblock-cms/cortex": "workspace:*",
    "@nextblock-cms/ui": "workspace:*",
    "@nextblock-cms/utils": "workspace:*",
    "@nextblock-cms/db": "workspace:*",
    "@nextblock-cms/editor": "workspace:*",
    "@nextblock-cms/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true,
    "@parcel/watcher": false,
    "less": false
  }
}
