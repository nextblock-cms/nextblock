# Public base URL of the site. `npm run setup` writes this; the local-dev default
# is http://localhost:4200 (the port `npx nx serve nextblock` listens on).
NEXT_PUBLIC_URL=
TARGET_URL=
NEXT_PUBLIC_IS_SANDBOX=
SANDBOX_RESET_ENABLED=false
# Sandbox-only contact inboxes. Read ONLY when NEXT_PUBLIC_IS_SANDBOX=true. Leave
# BLANK for real installs: the Privacy/Terms pages then use the CMS "Support email"
# (Settings -> Privacy) or fall back to privacy@example.com, and the contact form
# uses its own configured recipient. These keep our real addresses out of the
# open-source seed data while still letting the hosted demo reach the right inbox.
SANDBOX_PRIVACY_EMAIL=
SANDBOX_CONTACT_EMAIL=
# Google Tag Manager is configured in the CMS at Settings -> Privacy (stored in the
# site_settings table), not via env. There is no NEXT_PUBLIC_GTM_ID variable.
# Auto-generated (random) by `npm run setup`. Needed by the cron and revalidate routes.
# CRON_SECRET (16+ characters) also protects /api/affiliates/cron/payouts (daily partner payouts).
CRON_SECRET=
REVALIDATE_SECRET_TOKEN=

# Draft Mode / Vercel Toolbar / Nextblock visual editing
# Required for /api/draft?secret=... preview links. Auto-generated by `npm run setup`
DRAFT_MODE_SECRET=
# Optional: force the Nextblock visual editing overlay outside Draft Mode.
# Recommended default is false; Draft Mode enables it automatically.
NEXTBLOCK_VISUAL_EDITING_ENABLED=false
# Optional: force Vercel Toolbar injection locally, outside Vercel deployments, or on
# Vercel previews outside Draft Mode (the layout mounts it with the CSP nonce).
# Keep false for normal Nextblock Draft Mode; true starts Vercel's localhost
# event bridge and may print harmless ECONNRESET proxy noise during navigation.
# Local Toolbar usage also requires `vercel link` and the Vercel Toolbar Next plugin.
# Vercel previews: under the CSP's 'strict-dynamic' (0.23.4), CSP3 browsers block the comments
# toolbar Vercel injects without the nonce, so set true for the Preview environment to keep it.
NEXTBLOCK_VERCEL_TOOLBAR_ENABLED=false
# Optional: included in data-vercel-edit-info payloads for Vercel/custom tooling.
NEXTBLOCK_VERCEL_PROJECT_ID=
NEXTBLOCK_VERCEL_WORKSPACE_ID=
# Optional: print per-request cache diagnostics from proxy.ts during debugging.
NEXTBLOCK_CACHE_LOGGING_ENABLED=false

LHCI_GITHUB_APP_TOKEN=
FX_API_BASE_URL= # Optional. Defaults to https://api.frankfurter.dev

# Supabase  —  `npm run setup` fills this whole block.
# Reference ID: Project Settings > General. Connection string: Connect > Direct connection > URI.
SUPABASE_PROJECT_ID=
POSTGRES_URL=
# Database password (extracted from POSTGRES_URL by `npm run setup`).
POSTGRES_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal Access Token (Account > Access Tokens). Required to link & migrate the database.
SUPABASE_ACCESS_TOKEN=

## Cloudflare R2 storage  —  `npm run setup` fills this block.
# Powers media uploads, image processing, and full-site backups. Without R2 the app
# still builds and serves, but those endpoints return 500 and uploads fail.
R2_ACCOUNT_ID=
# Bucket name (Cloudflare dashboard > R2 > create a bucket).
R2_BUCKET_NAME=
# Public Development URL (Bucket > Settings > General), e.g. https://pub-xxxx.r2.dev.
# setup writes the same value to both: PUBLIC_URL feeds next/image + CSP,
# BASE_URL feeds media URL resolution.
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_R2_BASE_URL=
# Account API token (R2 > Manage API Tokens > Create Account API Token, Object Read & Write).
# The Secret Access Key is shown only once when the token is created.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email SMTP  —  `npm run setup` fills this block (SMTP2GO works very well).
# Required so Supabase can send the confirmation email your first admin needs to sign in.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Optional hosted-auth override when using custom SMTP
SUPABASE_AUTH_RATE_LIMIT_EMAIL_SENT=30

# Stripe Account Info
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal Payouts for affiliate commissions routed to PayPal (optional; docs/15).
# Credentials saved under CMS -> Affiliates -> PayPal payouts win over these.
# Server-only: never prefix them with NEXT_PUBLIC_. The public sandbox never reads them.
# Sandbox REST app (developer.paypal.com), used while the environment is sandbox:
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# Live REST app, used once the environment is live:
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET_KEY=
# "live" pays real money; anything else (or empty) is the PayPal sandbox.
PAYPAL_ENVIRONMENT=

##Freemius
FREEMIUS_DEVELOPER_ID=
# The developer key pair (Freemius -> My Profile -> Keys): one pair for every product of the
# account. Checkout, webhooks, license keys on orders, the vendor license claim, trials and
# coupons read each product's own keys from Freemius with it, so a store that sells several
# Freemius products needs nothing per product, and a product added in Freemius works after
# Sync from Freemius (which needs this pair too). CMS -> Payments holds the same fields (DB wins).
# It is a master key for the whole Freemius account: server-side only, never NEXT_PUBLIC_.
FREEMIUS_DEVELOPER_PUBLIC_KEY=
FREEMIUS_DEVELOPER_SECRET_KEY=
# One product's keys (the product -> Settings -> API & Keys), needed only without a developer
# pair or for a product the pair can't reach (another Freemius account). Keep the developer pair
# out of them: installs that kept it here still work (it counts once Freemius accepts it at
# developer scope), but it then opens no checkout and verifies no webhook as a product's keys.
# With FREEMIUS_PRODUCT_ID set, the one gap is an instance that has not yet seen Freemius accept
# that pair: one started after a revocation, or one whose developer checks Freemius has not
# answered yet (a cold start during a throttle or an outage). Move the pair out of the one-product
# names (the 0.23.4 upgrade notes say how), and after you rotate the developer pair, delete the
# old one from every field, the one-product names included.
FREEMIUS_PUBLIC_KEY="pk_..."
FREEMIUS_SECRET_KEY="sk_..."
# The Freemius product the two keys above belong to (CMS -> Payments "Product ID"; DB wins). Set it
# whenever they are a product's keys, also for a product outside the developer account: they then
# serve that product only and keep working while Freemius is slow or throttled (without a developer
# pair that reaches it, another product with no FREEMIUS_CHECKOUT_PRODUCTS_JSON entry has no keys:
# its checkout answers 503 and its webhooks are refused). Leave it empty only on a one-product
# store without FREEMIUS_DEVELOPER_ID: they then stand in for every product with no keys of its
# own. Empty beside a developer pair, they serve only a product outside a working pair's account
# or, when these names are the only "pair" and Freemius refuses it, a product Freemius confirms
# they belong to (one request per product); never while a dedicated pair is refused or Freemius
# can't be reached. docs/02 -> "Freemius keys".
FREEMIUS_PRODUCT_ID=
# Quote Freemius keys in .env files because they often contain characters like
# #, ;, <, >, =, or spaces that can be misparsed when left unquoted.
# The product's API bearer token: only for the one-product keys above (coupon sync and license
# reads without a developer pair) and the SDK-first sandbox generation path.
FREEMIUS_API_KEY="..."
# Optional fallback for more one-product keys: products the developer pair can't reach (another
# Freemius account), or installs without a developer pair. Keys grouped by Freemius product ID.
# Example:
# FREEMIUS_CHECKOUT_PRODUCTS_JSON={"24851":{"publicKey":"pk_product_checkout","secretKey":"sk_product_checkout","apiKey":"fs_api_bearer_optional"}}
FREEMIUS_CHECKOUT_PRODUCTS_JSON=
# Optional single-product sandbox override. Used only when the checked-out
# Freemius product matches FREEMIUS_PRODUCT_ID and FREEMIUS_SANDBOX_ENABLED=true.
FREEMIUS_ECOMMERCE_SANDBOX_PUBLIC_KEY="pk_..."
FREEMIUS_ECOMMERCE_SANDBOX_SECRET_KEY="sk_..."
# Toggle the real Freemius checkout into sandbox/test mode without enabling the
# app-wide demo sandbox. Uses the same product public/secret keys to generate
# sandbox tokens for @freemius/checkout.
FREEMIUS_SANDBOX_ENABLED=false
##Only for sandbox pre-ativations
FREEMIUS_ECOMMERCE_SANDBOX_KEY=

##NextBlock package purchases (vendor side only)
# Set to true ONLY on the deployment that sells the NextBlock packages (nextblock.dev).
# It enables POST /api/packages/claim-license, which hands a freshly purchased license key
# back to the buyer's CMS so the package activates there automatically after the
# in-dashboard Freemius checkout. Needs the vendor's Freemius developer key pair (above), which
# reaches every product it sells: 24851 (Commerce Pro), 28609 (Cortex AI) and 43273 (Affiliates).
# Without it (or each product's keys in FREEMIUS_CHECKOUT_PRODUCTS_JSON) the purchase still
# works, but the buyer pastes the emailed key instead.
NEXTBLOCK_LICENSE_CLAIM_ENABLED=false
# Where a CMS asks for its purchased key. Leave unset to use https://nextblock.dev.
# NEXTBLOCK_LICENSE_SERVICE_URL=
# NEXTBLOCK_LICENSE_CLAIM_ENABLED also enables POST /api/packages/provision-trial, which
# mints a 30-day Cortex AI trial key for `create-nextblock --non-interactive` (name + email,
# one trial per email). Cortex AI only: a request for any other package is refused as an
# unknown package, so this flag never opens trials of Commerce Pro or Affiliates. Same vendor
# credentials. Both routes answer 404 on the public sandbox whatever this flag says, and both
# are limited per client network (an IPv4 /24, an IPv6 /48) and per instance, because each
# request spends the developer key pair every Freemius flow of the store shares.

##Headless install (written by `create-nextblock --non-interactive`; leave blank otherwise)
# A package key the app activates on first use (no dashboard click needed). The CLI fills
# it with the trial key it provisioned from nextblock.dev.
NEXTBLOCK_LICENSE_KEY=
# trial | paid — only affects how the packages page labels the activation.
NEXTBLOCK_LICENSE_KIND=
# Bearer token accepted by /api/mcp and POST /api/setup/bootstrap (min. 32 chars). The CLI
# generates it and mirrors it into .mcp.json / .cursor/mcp.json for coding agents. Setting
# it is the MCP opt-in; the Cortex AI license is still required.
MCP_BEARER_TOKEN=

##MCP directory listings (vendor site only)
# Ownership token from Glama's connector claim panel, served at /.well-known/glama.json.
GLAMA_CLAIM_TOKEN=

##NextBlock Cortex AI
# Optional sandbox pre-activation key for the Cortex AI premium package.
FREEMIUS_AI_SANDBOX_KEY=
# Optional server-side OpenRouter override for sandbox/testing.
OPENROUTER_API_KEY=
# Required only when saving encrypted OpenRouter BYOK keys to the database.
CORTEX_AI_ENCRYPTION_KEY=
# Optional free stock-photo providers for Cortex AI's search_stock_photos tool.
# Set either one (both are free API keys); Pexels is preferred when both exist.
# Get a Pexels key: https://www.pexels.com/api/  |  Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

## NextBlock Affiliates
# Optional sandbox pre-activation key for the Affiliates & Creator Storefronts premium package.
# Set it on the public sandbox only: the sandbox reset activates the package with it and seeds
# the demo partner (partner@nextblock.dev / password, storefront /partners/studio-nova). Any
# placeholder works (e.g. sandbox-affiliates-demo): it is never sent to Freemius, and its last
# four characters show on the packages card, so never use a real license key.
# Stripe Connect and partner payouts stay disabled in the sandbox.
FREEMIUS_AFFILIATES_SANDBOX_KEY=
