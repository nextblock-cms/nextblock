{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db/src",
  "projectType": "library",
  "tags": ["scope:public"],
  "// targets": "to see all targets run: nx show project db --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/db"
      ],
      "options": {
        "commands": [
          "nx run db:vite-build",
          "node tools/scripts/copy-db-supabase.cjs libs/db/src/supabase dist/libs/db/supabase"
        ],
        "parallel": false
      },
      "dependsOn": [
        "typecheck"
      ]
    },
    "vite-build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/db"
      ],
      "options": {
        "command": "vite build",
        "cwd": "libs/db"
      }
    },
    "gen-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/gen-db-types.js"
      }
    }
  }
}
